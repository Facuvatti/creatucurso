# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://creatucurso:creatucurso@localhost:5432/creatucurso

# Domain that hosts the platform. Creator sites are <slug>.<PLATFORM_DOMAIN>,
# the central app is app.<PLATFORM_DOMAIN>. *.localhost works in Chromium.
PLATFORM_DOMAIN=localhost
PUBLIC_URL_SCHEME=http
# Port used in local URLs; leave empty in production.
PUBLIC_PORT=3000

# better-auth reads these two directly.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://app.localhost:3000

# Optional: enables "Sign in with Google". The only OAuth callback is
# ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
