# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://creatucurso:creatucurso@localhost:5439/creatucurso

# Domain that hosts the platform. Creator sites are <slug>.<PLATFORM_DOMAIN>,
# the central app is app.<PLATFORM_DOMAIN>. *.localhost works in Chromium.
PLATFORM_DOMAIN=localhost
PUBLIC_URL_SCHEME=http
# Port used in local URLs; leave empty in production.
PUBLIC_PORT=4310

# better-auth reads these two directly.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://app.localhost:3000

# Optional: enables "Sign in with Google". The OAuth callback is
# ${BETTER_AUTH_URL}/api/auth/callback/google
# The same Google OAuth client is used to send email from each academy's Gmail
# (ADR-0028); add the authorized redirect URI <app origin>/api/gmail/callback too.
# Gmail sending needs these two (and SECRETS_ENCRYPTION_KEY) even if you do not
# offer "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Hyperswitch) -------------------------------------------------
# Start it with: infra/hyperswitch/up.sh up   (see docs/hyperswitch.md)
# Leave these empty to run the app without payments.

# Encrypts the creators' payment credentials stored in our database.
# Generate once:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Where the app reaches the Hyperswitch API (server to server).
HYPERSWITCH_URL=http://localhost:8080
# Platform admin key. For the local Docker setup it is "test_admin"
# (config/docker_compose.toml in the Hyperswitch checkout). Change it in production.
HYPERSWITCH_ADMIN_API_KEY=test_admin
# Where the BROWSER reaches the Hyperswitch API (checkout widget).
HYPERSWITCH_PUBLIC_URL=http://localhost:8080
# Checkout widget script served by the hyperswitch-web container.
HYPERSWITCH_SDK_URL=http://localhost:9050/HyperLoader.js
# Where the Hyperswitch CONTAINER calls our webhook. From Docker, your machine
# is host.docker.internal (the override file maps it). Use your app's real port.
HYPERSWITCH_WEBHOOK_BASE_URL=http://host.docker.internal:3000

# --- Mercado Pago marketplace (ADR-0023, see docs/mercadopago.md) --------------
# One application owned by the platform; each academy links its seller account
# with OAuth. Tokens are stored encrypted with SECRETS_ENCRYPTION_KEY, which also
# derives the key that signs the OAuth state. Mercado Pago is available only when
# the first three and SECRETS_ENCRYPTION_KEY are set.
# Application id and secret (Your integrations > your application > Credentials).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# "Secret signature" of the application's webhooks (Webhooks > Configure notifications).
MP_WEBHOOK_SECRET=
# Authorization page. Default: https://auth.mercadopago.com/authorization
MP_AUTH_URL=
# API base. Default: https://api.mercadopago.com. Override only to point at a local mock.
MP_API_URL=
# The platform commission is collected at sale time as the preference's marketplace_fee,
# computed per academy plan in src/areas/billing/billing.ts (ADR-0029). There is no global
# marketplace-fee percent any more.
# Redirect URL registered in the application: <app origin>/api/mercadopago/callback
# Notification URL: <base>/api/webhooks/mercadopago, where <base> is the app origin
# or, only when the public URL differs (a tunnel while testing), this value:
MERCADOPAGO_WEBHOOK_BASE_URL=

# --- Worker (outbox) -----------------------------------------------------------
# Port of the worker's health route (GET /health). Start it with: pnpm worker
WORKER_PORT=3101

# --- Basic video tier (ADR-0020; infra/media/compose.yaml, pnpm media:encode) --
# Directory shared by tusd, nginx, the encoder and the app: originals in
# uploads/, encrypted HLS in hls/. Default: ./media-data
MEDIA_ROOT=./media-data
# Where the BROWSER reaches the media node (nginx: signed segments + /files/ for tus).
MEDIA_PUBLIC_URL=http://media.localhost:8088
# Signs playback/upload tokens and nginx secure_link URLs. Generate: openssl rand -hex 32
MEDIA_SECRET=
# Shared with tusd's hook URL (query string). Use hex: openssl rand -hex 32
MEDIA_HOOK_SECRET=
# Limits (defaults shown): 2 GB, 60 minutes, 50 GB per academy, 30 simultaneous streams.
MEDIA_MAX_BYTES=2147483648
MEDIA_MAX_SECONDS=3600
MEDIA_TENANT_QUOTA_BYTES=53687091200
MEDIA_MAX_STREAMS=30
# Health route of the encoder (GET /health).
MEDIA_ENCODER_PORT=3102

# --- Custom domains of creators (ADR-0024; Cloudflare for SaaS, docs/cloudflare.md) --
# Optional. Without token and zone the panel says custom domains are not enabled.
# API token with permission "SSL and Certificates: Edit" on the platform zone.
CLOUDFLARE_API_TOKEN=
# Zone id of PLATFORM_DOMAIN (Cloudflare dashboard > the zone > Overview).
CLOUDFLARE_ZONE_ID=
# Fallback origin: creators point a CNAME to this name. Default: dominios.<PLATFORM_DOMAIN>
CUSTOM_DOMAIN_TARGET=
# Root domains (maria.com, A record; ADR-0031). Cloudflare has no public fixed IPs: they
# come from the apex proxying add-on (Enterprise), assigned by your Cloudflare account team.
# Comma-separated. Empty = creators can only connect subdomains (cursos.maria.com).
CUSTOM_DOMAIN_APEX_IPV4=
CUSTOM_DOMAIN_APEX_IPV6=
# Only to point at a local mock of the Cloudflare API in manual tests. Leave empty.
CLOUDFLARE_API_URL=

# --- One-click custom domains (ADR-0030; Domain Connect, docs/domain-connect-setup.md)
# Optional. Without both values the panel only shows the manual CNAME instructions.
# Private RSA key that signs the apply requests: PEM, or the PEM in base64 on one
# line. Secret: never commit or log it.
DOMAIN_CONNECT_PRIVATE_KEY=
# Name of the TXT records with the public key under the platform domain, e.g. _dck1
DOMAIN_CONNECT_KEY_ID=
# Only for manual tests against a local mock DNS provider. Leave empty.
DOMAIN_CONNECT_DISCOVERY_OVERRIDE=

# --- Email automations (ADR-0026) ----------------------------------------------
# Every academy sends from its own Gmail account, connected with OAuth from the
# panel, and the platform (verification, password reset) from the Gmail connected
# at <app origin>/admin/correo. Setup: docs/gmail-setup.md. Without a connected
# Gmail, platform emails are printed to the server console and academy emails wait.
# Unsubscribe links are signed with a key derived from SECRETS_ENCRYPTION_KEY.
# The only user allowed to connect the platform mailbox at /admin/correo.
PLATFORM_ADMIN_EMAIL=
# Emails one academy may send per rolling 24 h. Gmail allows 500 (personal) or 2000
# (Workspace) a day: the default leaves a margin.
GMAIL_DAILY_LIMIT=400
# Only to point at a local mock of Google's endpoints in manual tests. Leave empty.
GOOGLE_AUTH_URL=
GOOGLE_TOKEN_URL=
GOOGLE_API_URL=

# --- Academy billing (ADR-0029; trial, usage, monthly subscription) -------------
# The academies pay the PLATFORM with a Mercado Pago subscription. Create a separate
# application in the platform's own Mercado Pago account (product: Suscripciones).
# Its production access token (Credentials). Secret: never commit or log it.
MP_PLATFORM_ACCESS_TOKEN=
# "Secret signature" of that application's webhooks. Notification URL:
# <app origin>/api/webhooks/mercadopago-billing, topics: subscription_preapproval and
# subscription_authorized_payment. Without both values the panel cannot subscribe.
MP_PLATFORM_WEBHOOK_SECRET=
# Free trial: 30 days from the creation of the academy, at most 10 students. Academies
# that existed before billing get their trial from this date: set the deploy date.
BILLING_TRIAL_START=2026-10-21
# The plans and their prices are the owner's (docs/planes_suscripcion.md) and live in
# src/areas/billing/billing.ts. What the video costs the platform per unit, in ARS
# (recorded daily for the owner's numbers, not charged; placeholders: set real costs).
BILLING_PRICE_PER_GB_STREAM=15
BILLING_PRICE_PER_GB_STORAGE_MONTH=25
# Days between a failed (or missing) payment and the suspension of the academy.
BILLING_GRACE_DAYS=10
