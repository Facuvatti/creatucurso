# Copy to .env.production on the APP machine and fill every value. Never commit it.
# Used by: docker compose --env-file .env.production -f infra/app/compose.yaml ...
# Generate random secrets with:  openssl rand -hex 32   (hex avoids URL-escaping problems)

# --- Domain -----------------------------------------------------------------------
# Domain that hosts the platform. Creator sites are <slug>.<PLATFORM_DOMAIN>, the
# central app is app.<PLATFORM_DOMAIN>, errors.<...> is the error tracker and
# status.<...> is Uptime Kuma. DNS: A/AAAA for the apex and "*" to this machine.
PLATFORM_DOMAIN=example.com
PUBLIC_URL_SCHEME=https
# Leave empty in production (default HTTPS port).
PUBLIC_PORT=

# --- Postgres (used to build DATABASE_URL for web, worker and migrations) -------
POSTGRES_USER=creatucurso
# Hex string, no special characters (it goes inside a URL).
POSTGRES_PASSWORD=
POSTGRES_DB=creatucurso

# --- Auth (better-auth) ----------------------------------------------------------
# Long random value. Changing it logs everybody out.
BETTER_AUTH_SECRET=
# Public URL of the central app. Must match https://app.<PLATFORM_DOMAIN>.
BETTER_AUTH_URL=https://app.example.com
# Optional "Sign in with Google". Callback: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Encryption of creators' payment credentials ---------------------------------
# openssl rand -base64 32 . Back it up OFF this machine: without it the stored
# credentials cannot be decrypted (see docs/runbook.md, "What else to back up").
SECRETS_ENCRYPTION_KEY=

# --- Transactional email (ADR-0016) ----------------------------------------------
RESEND_API_KEY=
# For example "Creatucurso <hola@example.com>". Domain must be verified in Resend.
EMAIL_FROM=

# --- Payments: Hyperswitch (runs on the payments machine, docs/hyperswitch.md) ---
# Server to server address of the Hyperswitch API.
HYPERSWITCH_URL=https://pay.example.com
# Platform admin key of that Hyperswitch. Never leave the default test key here.
HYPERSWITCH_ADMIN_API_KEY=
# Address the BROWSER uses for the API and for the checkout widget script.
HYPERSWITCH_PUBLIC_URL=https://pay.example.com
HYPERSWITCH_SDK_URL=https://pay.example.com/HyperLoader.js
# Address Hyperswitch uses to call our webhook. Must be reachable from the payments machine.
HYPERSWITCH_WEBHOOK_BASE_URL=https://app.example.com

# --- Payments: Mercado Pago (docs/mercadopago.md) ---------------------------------
# Only set when the public URL for webhooks differs from the app's origin.
MERCADOPAGO_WEBHOOK_BASE_URL=

# --- Worker ------------------------------------------------------------------------
# Port of the worker's /health inside its container. Keep 3101 (compose maps it).
WORKER_PORT=3101

# --- Logging and error tracking --------------------------------------------------
# pino level: trace, debug, info, warn, error.
LOG_LEVEL=info
# DSN of the project created in Bugsink (https://errors.<PLATFORM_DOMAIN>).
# From inside the stack use the internal address: http://<key>@bugsink:8000/1
# Leave empty to disable error reporting.
SENTRY_DSN=

# --- Caddy (TLS) -----------------------------------------------------------------
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=
# Module of the DNS host, built into Caddy (https://github.com/caddy-dns). Changing it
# needs: docker compose ... build caddy
DNS_PROVIDER=cloudflare
# API token of that DNS host, only permission to edit DNS of PLATFORM_DOMAIN.
DNS_API_TOKEN=

# --- Error tracker and monitor ---------------------------------------------------
BUGSINK_SECRET_KEY=
# First admin as user:password, created on first start, for example admin:a-long-password
BUGSINK_SUPERUSER=

# --- Backups (WAL-G, docs/runbook.md) --------------------------------------------
# Absolute host path on a DIFFERENT disk than the database volume. Must exist and be
# writable by uid 999 (postgres): sudo mkdir -p <dir> && sudo chown 999:999 <dir>
BACKUP_DIR=/mnt/backup/creatucurso
# 64 hex chars (32 bytes): openssl rand -hex 32 . Encrypts backups. Back it up OFF
# this machine; without it the backups cannot be restored.
WALG_LIBSODIUM_KEY=
# Hours between base backups and how many full backups to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN_FULL=7

# --- Media node (infra/media, documented there) -----------------------------------
# Variables of the video pieces are listed in infra/media; add them here when you
# enable them.
