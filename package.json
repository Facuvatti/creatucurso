{
  "name": "creatucurso",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "worker": "node --env-file=.env src/worker/index.ts",
    "media:encode": "node --env-file=.env src/media/encoder.ts",
    "db:auth": "node scripts/sync-auth-schema.ts",
    "db:auth:check": "node scripts/sync-auth-schema.ts --check",
    "db:reset": "node --env-file=.env scripts/reset-dev-db.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "^1.7.11",
    "hls.js": "^1.7.3",
    "kysely": "^0.29.7",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "^1.7.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
